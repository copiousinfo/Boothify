<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White Background -->
    <solid android:color="#FFFFFF"/>

    <!-- Dashed Border -->
    <stroke
        android:width="1dp"
        android:color="#D1D5DB"
        android:dashWidth="6dp"
        android:dashGap="4dp"/>

    <!-- Rounded Corners -->
    <corners android:radius="16dp"/>

</shape>