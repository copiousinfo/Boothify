<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <solid android:color="#F3F4F6"/>

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="#E5E7EB"/>

    <!-- Rounded Corners -->
    <corners android:radius="12dp"/>

    <!-- Padding -->
