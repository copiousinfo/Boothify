<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#FFFFFF">

        <!-- TOP SECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- PROFILE -->

            <ImageView
                android:id="@+id/itemIamge"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/outline_person_24"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_bg"
                android:padding="2dp"/>

            <!-- DETAILS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prateek Upadhyay"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111"/>

                <TextView
                    android:id="@+id/txtMemberId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Member ID : 4521"
                    android:textColor="#666"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp"/>

                <TextView
                    android:id="@+id/txtBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Block : A-12"
                    android:textColor="#666"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"/>

        <!-- ROLE SECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Party Role : "
                android:textStyle="bold"
                android:textColor="#111"/>

            <TextView
                android:id="@+id/txtRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empty"
                android:textColor="#DC2626"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnAssignRole"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Assign Role"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="#2563EB"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnGenerateId"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Generate ID"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="#059669"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>